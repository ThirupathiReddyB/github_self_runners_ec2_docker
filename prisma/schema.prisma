model Items {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now()) @map("created_at")
  name          String
  type          ItemType
  planDetails   Json?
  amount        Int
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Blog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  title     String   @unique
  isActive  Boolean  @default(true)
  author    String
  updatedBy String   @map("updated_by")
  thumbnail String
  content   String
  readTime  Int      @map("read_time")
  tags      Tags[]   @relation("BlogToTags")
}

model Story {
  id         Int          @id @default(autoincrement())
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  title      String       @unique
  isActive   Boolean      @default(true)
  updatedBy  String       @map("updated_by")
  storyImage StoryImage[]
  tags       Tags[]       @relation("StoryToTags")
}

model StoryImage {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  storyId     Int
  title       String?  @db.VarChar(280)
  description String?  @db.VarChar(2048)
  filename    String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model Profile {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  name        String
  address     String
  cin         String
  gstin       String
  msmeNo      String   @map("msme_no")
  gst         Int
  companyLogo String   @map("company_logo")
  signatory   String
  website     String
  email       String
  phoneNumber String   @map("phone_number")
}

model Tags {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  name      String   @unique
  blog      Blog[]   @relation("BlogToTags")
  story     Story[]  @relation("StoryToTags")
  video     Video[]  @relation("TagsToVideo")
}

model Integrations {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  embedLink String?  @map("embed_link")
  isActive  Boolean  @map("is_active")
}

model AppVersion {
  id              Int               @id @default(autoincrement())
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  appVersion      String            @map("app_version")
  appEnv          AppEnv            @map("app_env")
  isForce         Boolean           @default(false) @map("is_force")
  isActive        Boolean           @map("is_active")
  versionFeatures VersionFeatures[]
}

model VersionFeatures {
  id                 Int        @id @default(autoincrement())
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  appVersionId       Int
  featureDescription String     @map("feature_description")
  appVersion         AppVersion @relation(fields: [appVersionId], references: [id], onDelete: Cascade)
}

